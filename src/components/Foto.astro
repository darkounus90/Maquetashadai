---
import dimensiones from '../data/dimensiones.json';

interface Props {
  id: string;
  alt: string;
  class?: string;
  /** La primera imagen visible no debe ir en lazy. */
  prioridad?: boolean;
  sizes?: string;
}
const { id, alt, class: clase = '', prioridad = false, sizes = '100vw' } = Astro.props;

// Antes esto iba fijo en 1024x683 para todas. Es falso: los originales van de
// 432x768 a 1024x768, y declarar una proporción que no es reserva el hueco
// equivocado mientras carga. El tamaño real lo escribe scripts/fotos.mjs.
const [ancho, alto] = (dimensiones as Record<string, [number, number]>)[id] ?? [1024, 683];
---

<img
  src={`/img/fotos/${id}.webp`}
  alt={alt}
  sizes={sizes}
  width={ancho}
  height={alto}
  loading={prioridad ? 'eager' : 'lazy'}
  decoding={prioridad ? 'sync' : 'async'}
  fetchpriority={prioridad ? 'high' : 'auto'}
  class:list={['h-full w-full object-cover', clase]}
/>
