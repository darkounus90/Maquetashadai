---
import { useTranslations, ruta } from '../i18n/ui';
import type { Lang } from '../data/hotel';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section
  data-hero
  class="relative isolate flex min-h-[100svh] flex-col justify-end overflow-hidden bg-deep"
>
  <!-- La Vía Láctea sobre el Desierto de la Tatacoa, vista desde la azotea -->
  <img
    src="/img/fotos/f52.webp"
    alt={lang === 'es'
      ? 'La Vía Láctea sobre el Desierto de la Tatacoa, vista desde el hotel'
      : 'The Milky Way over the Tatacoa Desert, seen from the hotel'}
    width="1024"
    height="683"
    fetchpriority="high"
    decoding="sync"
    class="absolute inset-0 -z-10 h-full w-full object-cover"
  />
  <!-- Velo inferior: solo lo necesario para que el texto pase contraste AA -->
  <div
    class="absolute inset-x-0 bottom-0 -z-10 h-[70%] bg-gradient-to-t from-deep via-deep/75 to-transparent"
    aria-hidden="true"
  >
  </div>

  <div class="contenedor grid gap-9 pb-16 pt-24 lg:grid-cols-12 lg:items-end lg:gap-12 lg:pb-20">
    <h1
      class="max-w-[13ch] font-display text-hero font-extrabold text-white lg:col-span-7"
      style="font-variation-settings:'opsz' 96,'wdth' 88"
    >
      {t('hero.titulo')}
    </h1>

    <div class="lg:col-span-5 lg:pb-3">
      <p class="max-w-sm text-[0.9375rem] leading-relaxed text-white/80">
        {t('hero.bajada')}
      </p>
      <div class="mt-7 flex flex-wrap gap-2.5">
        <a href={ruta(lang, '/reservar')} class="btn btn-brasa">{t('hero.cta')}</a>
        <a href={ruta(lang, '/habitaciones')} class="btn btn-sobre-foto">{t('hero.cta2')}</a>
      </div>
    </div>
  </div>
</section>
