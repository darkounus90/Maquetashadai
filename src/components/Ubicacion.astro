---
import { Icon } from 'astro-icon/components';
import { useTranslations } from '../i18n/ui';
import { hotel } from '../data/hotel';
import type { Lang } from '../data/hotel';
import Titulo from './Titulo.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);

const { lat, lng } = hotel.coords;

// Embebido de Google Maps sin clave de API. La etiqueta entre paréntesis es lo
// que Google escribe junto al marcador, así el pin sale con el nombre del hotel
// en vez de con las coordenadas en crudo.
//
// A diferencia del de OpenStreetMap, este mapa NO se filtra ni se recorta: las
// condiciones de Google prohíben alterar u ocultar su logo y su atribución.
const etiqueta = encodeURIComponent(hotel.nombreCompleto);
const mapa =
  `https://maps.google.com/maps?q=${lat},${lng}(${etiqueta})` +
  `&z=14&hl=${lang}&output=embed`;
const maps = `https://www.google.com/maps/search/?api=1&query=${lat},${lng}`;

// Coordenadas en el formato de un plano, no en decimal crudo.
const coordenadas =
  `${Math.abs(lat).toFixed(4)}° ${lat >= 0 ? 'N' : 'S'}  ` +
  `${Math.abs(lng).toFixed(4)}° ${lng >= 0 ? 'E' : lang === 'es' ? 'O' : 'W'}`;

const activar = {
  es: 'Toque para mover el mapa',
  en: 'Tap to move the map',
}[lang];
---

<section class="bg-fondo py-24 lg:py-32">
  <div class="contenedor grid gap-12 lg:grid-cols-12 lg:items-center lg:gap-16">
    <div class="lg:col-span-5">
      <Titulo
        titulo={t('ubi.titulo')}
        bajada={t('ubi.bajada')}
      />

      <address class="revelar mt-8 flex items-start gap-3 text-sm not-italic leading-relaxed text-ink-2">
        <Icon name="ph:map-pin" class="mt-0.5 h-4 w-4 shrink-0 text-oro-luz" />
        {hotel.direccion}
      </address>

      <dl class="revelar mt-8 divide-y divide-line border-y border-line">
        {
          hotel.distancias[lang].map(([lugar, dist]) => (
            <div class="flex items-baseline justify-between gap-6 py-3.5">
              <dt class="text-sm text-ink-2">{lugar}</dt>
              <dd class="shrink-0 font-display text-sm text-oro-luz">{dist}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <!-- Placa: cabecera con coordenadas, mapa de Google tal cual lo sirve, y
         pie con la acción. -->
    <figure class="revelar border border-line-2 bg-panel lg:col-span-7">
      <figcaption
        class="flex items-center justify-between gap-4 border-b border-line-2 px-4 py-3"
      >
        <span class="rotulo flex items-center gap-2 text-ink-2">
          <Icon name="ph:crosshair" class="h-3.5 w-3.5 shrink-0 text-oro-luz" />
          <span class="tabular-nums">{coordenadas}</span>
        </span>
        <span class="rotulo hidden text-ink-3 sm:block">Villavieja · Huila</span>
      </figcaption>

      <!-- Alto fijo en móvil, no proporción: por debajo de unos 300 px Google
           esconde su propio logo y su atribución, que no se pueden omitir. Con
           `aspect-ratio` y `min-height` juntos el ancho se calcula del alto y
           la placa se sale de la pantalla. -->
      <div id="placa-mapa" class="relative h-80 bg-fondo-2 lg:h-auto lg:aspect-[16/10]">
        <iframe
          src={mapa}
          title={lang === 'es'
            ? 'Mapa de la ubicación del hotel en Villavieja'
            : 'Map showing the hotel location in Villavieja'}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          class="pointer-events-none absolute inset-0 h-full w-full"></iframe>

        <!-- Un mapa embebido secuestra el scroll: en móvil el dedo intenta
             bajar por la página y termina arrastrando el mapa. Queda inerte
             hasta que se toca a propósito. La capa es transparente para no
             tapar el logo ni la atribución de Google. -->
        <button
          type="button"
          id="activar-mapa"
          class="group absolute inset-0 flex items-start justify-center pt-4"
          aria-label={activar}
        >
          <span
            class="border border-line-2 bg-deep/85 px-4 py-2 text-[0.6875rem] font-semibold uppercase tracking-[0.13em] text-ink backdrop-blur transition-colors group-hover:border-ink"
          >
            {activar}
          </span>
        </button>
      </div>

      <div class="flex items-center justify-between gap-4 border-t border-line-2 px-4 py-3">
        <span class="truncate text-[0.6875rem] leading-tight text-ink-3">
          {hotel.nombreCompleto}
        </span>
        <a
          href={maps}
          target="_blank"
          rel="noopener"
          class="rotulo group flex shrink-0 items-center gap-2 text-ink transition-colors hover:text-oro-luz"
        >
          {t('ubi.mapa')}
          <Icon
            name="ph:arrow-up-right"
            class="h-3.5 w-3.5 transition-transform group-hover:-translate-y-px group-hover:translate-x-px"
          />
        </a>
      </div>
    </figure>
  </div>
</section>

<script is:inline>
  (() => {
    const capa = document.getElementById('activar-mapa');
    const marco = document.getElementById('placa-mapa')?.querySelector('iframe');
    if (!capa || !marco) return;
    capa.addEventListener('click', () => {
      marco.classList.remove('pointer-events-none');
      capa.remove();
    });
  })();
</script>
