---
import { Icon } from 'astro-icon/components';
import { useTranslations, ruta } from '../i18n/ui';
import type { Lang } from '../data/hotel';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="border-b border-line bg-panel">
  <form
    id="buscador"
    action={ruta(lang, '/reservar')}
    method="get"
    class="contenedor grid gap-5 py-7 lg:grid-cols-[1fr_1fr_11rem_auto] lg:items-end lg:gap-4"
  >
    <div>
      <label class="etiqueta" for="b-entrada">{t('buscador.entrada')}</label>
      <input class="campo" type="date" id="b-entrada" name="entrada" required />
    </div>
    <div>
      <label class="etiqueta" for="b-salida">{t('buscador.salida')}</label>
      <input class="campo" type="date" id="b-salida" name="salida" required />
    </div>
    <div>
      <label class="etiqueta" for="b-huespedes">{t('buscador.huespedes')}</label>
      <select class="campo" id="b-huespedes" name="huespedes">
        {
          [1, 2, 3, 4, 5, 6, 7].map((n) => (
            <option value={n} selected={n === 2}>
              {n} {n === 1 ? t('hab.persona') : t('hab.personas')}
            </option>
          ))
        }
      </select>
    </div>
    <button type="submit" class="btn btn-brasa h-[46px] w-full lg:w-auto">
      {t('buscador.buscar')}
    </button>

    <p class="flex items-center gap-2 text-xs text-ink-3 lg:col-span-4">
      <Icon name="ph:shield-check" class="h-4 w-4 shrink-0 text-brasa-luz" />
      {t('buscador.nota')}
    </p>
  </form>
</section>

<script>
  import { hoyISO } from '../lib/precios';

  const entrada = document.getElementById('b-entrada') as HTMLInputElement | null;
  const salida = document.getElementById('b-salida') as HTMLInputElement | null;

  if (entrada && salida) {
    entrada.min = hoyISO();
    salida.min = hoyISO(1);
    entrada.value = hoyISO(14);
    salida.value = hoyISO(16);

    entrada.addEventListener('change', () => {
      const siguiente = new Date(entrada.value + 'T12:00:00');
      siguiente.setDate(siguiente.getDate() + 1);
      const minSalida = siguiente.toISOString().slice(0, 10);
      salida.min = minSalida;
      if (salida.value <= entrada.value) salida.value = minSalida;
    });
  }
</script>
