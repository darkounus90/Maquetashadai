---
interface Props {
  class?: string;
  claro?: boolean;
}
const { class: clase = '', claro = false } = Astro.props;
---

<span class:list={['flex items-center gap-2.5 leading-none', clase]}>
  <!-- Marca geométrica: la línea del horizonte del desierto con una estrella encima. -->
  <svg viewBox="0 0 28 28" fill="none" class="h-full w-auto shrink-0" aria-hidden="true">
    <rect x="0.5" y="0.5" width="27" height="27" stroke="currentColor" stroke-opacity="0.35" />
    <path d="M14 6.5l1.4 4.1 4.1 1.4-4.1 1.4L14 17.5l-1.4-4.1-4.1-1.4 4.1-1.4L14 6.5z" fill={claro ? 'var(--color-oro)' : 'currentColor'} />
    <path d="M5 21h18" stroke="currentColor" stroke-opacity="0.5" stroke-width="1.2" />
  </svg>

  <span class="flex flex-col justify-center gap-[0.22em]">
    <span
      class="font-display text-[0.98em] font-semibold uppercase tracking-[0.08em]"
    >
      El Shaddai
    </span>
    <span class="text-[0.34em] font-semibold uppercase tracking-[0.38em] text-ink-3">
      Punta del Este
    </span>
  </span>
</span>
