---
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import Foto from '../components/Foto.astro';
import Lightbox from '../components/Lightbox.astro';
import CardHabitacion from '../components/CardHabitacion.astro';
import CtaFinal from '../components/CtaFinal.astro';
import { useTranslations, ruta } from '../i18n/ui';
import { habitaciones, temporadas, servicios, hotel } from '../data/hotel';
import { cop } from '../lib/precios';
import type { Habitacion, Lang, Temporada } from '../data/hotel';

interface Props { lang: Lang; hab: Habitacion }
const { lang, hab } = Astro.props;
const t = useTranslations(lang);

const temps: Temporada[] = ['baja', 'media', 'alta'];
const otras = habitaciones.filter((h) => h.slug !== hab.slug);

const title =
  lang === 'es'
    ? `${hab.nombre.es} | El Shaddai Punta del Este, Tatacoa`
    : `${hab.nombre.en} | El Shaddai Punta del Este, Tatacoa Desert`;
const description = `${hab.resumen[lang]} ${hab.camas[lang]}. ${
  lang === 'es' ? 'Desde' : 'From'
} ${cop(hab.precios.baja, lang)} ${lang === 'es' ? 'la noche, desayuno incluido.' : 'per night, breakfast included.'}`;

const site = (Astro.site?.origin ?? 'https://elshaddaipuntadeleste.com').replace(/\/+$/, '');
const prefijo = lang === 'es' ? '' : '/en';
const urlHab = `${site}${prefijo}/habitaciones/${hab.slug}/`;

const schemaHabitacion = {
  '@context': 'https://schema.org',
  '@type': 'HotelRoom',
  '@id': `${urlHab}#habitacion`,
  name: hab.nombre[lang],
  description: hab.descripcion[lang],
  url: urlHab,
  image: hab.fotos.slice(0, 3).map((f) => `${site}/img/fotos/${f}.webp`),
  bed: hab.camas[lang],
  occupancy: { '@type': 'QuantitativeValue', maxValue: hab.capacidad, unitCode: 'C62' },
  floorSize: { '@type': 'QuantitativeValue', value: hab.m2, unitCode: 'MTK' },
  containedInPlace: { '@id': `${site}/#hotel` },
  // El precio declarado es el de temporada baja, que es el "desde" que se ve
  // en la página. El total real lo calcula el motor noche a noche.
  offers: {
    '@type': 'Offer',
    price: hab.precios.baja,
    priceCurrency: 'COP',
    availability: 'https://schema.org/InStock',
    url: `${site}${prefijo}/reservar/`,
  },
};

// Refleja la miga de pan que ya está visible arriba de la ficha.
const schemaMiga = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t('nav.inicio'), item: `${site}${prefijo}/` },
    {
      '@type': 'ListItem',
      position: 2,
      name: t('nav.habitaciones'),
      item: `${site}${prefijo}/habitaciones/`,
    },
    { '@type': 'ListItem', position: 3, name: hab.nombre[lang], item: urlHab },
  ],
};
---

<Base
  lang={lang}
  title={title}
  description={description}
  path={`/habitaciones/${hab.slug}`}
  ogImage={`/img/fotos/${hab.fotos[0]}.webp`}
  schemaExtra={[schemaHabitacion, schemaMiga]}
>
  <div class="pt-24 lg:pt-28">
    <!-- Mosaico de fotos -->
    <div class="contenedor pt-6">
      <nav class="mb-6 text-xs text-ink-3" aria-label="breadcrumb">
        <a href={ruta(lang, '/')} class="transition-colors hover:text-ink">{t('nav.inicio')}</a>
        <span class="mx-2">/</span>
        <a href={ruta(lang, '/habitaciones')} class="transition-colors hover:text-ink">
          {t('nav.habitaciones')}
        </a>
        <span class="mx-2">/</span>
        <span class="text-ink-2">{hab.nombre[lang]}</span>
      </nav>

      <div class="grid gap-3 sm:grid-cols-4 sm:grid-rows-2">
        {
          hab.fotos.slice(0, 5).map((f, i) => (
            <button
              type="button"
              data-foto={`/img/fotos/${f}.webp`}
              data-alt={hab.nombre[lang]}
              class:list={[
                'group relative block overflow-hidden bg-panel',
                i === 0 ? 'sm:col-span-2 sm:row-span-2' : '',
                i > 2 ? 'hidden sm:block' : '',
              ]}
            >
              <div class:list={[i === 0 ? 'aspect-[4/3] sm:h-full sm:aspect-auto' : 'aspect-[4/3]']}>
                <Foto
                  id={f}
                  alt={hab.nombre[lang]}
                  prioridad={i === 0}
                  sizes={i === 0 ? '(min-width:640px) 50vw, 100vw' : '(min-width:640px) 25vw, 100vw'}
                  class="transition-transform duration-[900ms] ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-105"
                />
              </div>
            </button>
          ))
        }
      </div>
    </div>

    <div class="contenedor grid gap-12 py-16 lg:grid-cols-12 lg:gap-16 lg:py-24">
      <div class="lg:col-span-7">
        <h1 class="font-display text-titulo font-extrabold">{hab.nombre[lang]}</h1>
        <p class="mt-3 text-sm text-ink-3">
          {hab.capacidad} {hab.capacidad === 1 ? t('hab.persona') : t('hab.personas')}, {hab.m2} m²
        </p>
        <p class="mt-6 text-lg leading-relaxed text-ink-2">{hab.descripcion[lang]}</p>

        <h2 class="mt-12 font-display text-xl font-normal">{t('hab.incluye')}</h2>
        <ul class="mt-6 grid gap-x-8 gap-y-4 sm:grid-cols-2">
          {
            servicios.map((s) => (
              <li class="flex items-start gap-3 text-sm text-ink-2">
                <Icon name={s.icono} class="mt-px h-[1.125rem] w-[1.125rem] shrink-0 text-brasa-luz" />
                {s[lang][0]}
              </li>
            ))
          }
        </ul>

        <h2 class="mt-12 font-display text-xl font-normal">{t('hab.precios')}</h2>
        <dl class="mt-6 space-y-4">
          {
            temps.map((tp) => (
              <div class="border border-line bg-base-2 p-5">
                <div class="flex items-baseline justify-between gap-6">
                  <dt class="font-display text-base">{temporadas[tp].nombre[lang]}</dt>
                  <dd class="font-display text-lg">
                    {cop(hab.precios[tp], lang)}
                    <span class="text-xs text-ink-3"> / {t('hab.noche')}</span>
                  </dd>
                </div>
                <p class="mt-2 text-xs leading-relaxed text-ink-3">{temporadas[tp].desc[lang]}</p>
              </div>
            ))
          }
        </dl>
      </div>

      <!-- Tarjeta de reserva -->
      <aside class="lg:col-span-5">
        <div class="lg:sticky lg:top-28">
          <div class="border border-line bg-panel p-6">
            <p class="text-xs uppercase tracking-widest text-ink-3">{t('hab.desde')}</p>
            <p class="mt-1.5 flex items-baseline gap-2">
              <span class="font-display text-3xl">{cop(hab.precios.baja, lang)}</span>
              <span class="text-sm text-ink-3">/ {t('hab.noche')}</span>
            </p>

            <ul class="mt-6 space-y-2.5 border-t border-line pt-6 text-sm text-ink-2">
              {
                [t('res.desayuno'), t('res.pagoHotel'), t('res.sinTarjeta')].map((x) => (
                  <li class="flex items-center gap-2.5">
                    <Icon name="ph:check" class="h-4 w-4 shrink-0" />
                    {x}
                  </li>
                ))
              }
            </ul>

            <a href={ruta(lang, `/reservar?habitacion=${hab.slug}`)} class="btn btn-claro mt-6 w-full">
              {t('hab.reservar')}
            </a>

            <p class="mt-4 text-center text-xs text-ink-3">
              {lang === 'es' ? '¿Prefiere hablar con alguien?' : 'Prefer to talk to someone?'}
              <a href={`tel:${hotel.tel}`} class="ml-1 underline underline-offset-2 hover:text-ink">
                {hotel.telVisible}
              </a>
            </p>
          </div>

          <dl class="mt-6 space-y-3 px-1 text-sm">
            <div class="flex justify-between gap-4">
              <dt class="text-ink-3">{t('con.checkin')}</dt>
              <dd>{hotel.checkIn}</dd>
            </div>
            <div class="flex justify-between gap-4">
              <dt class="text-ink-3">{t('con.checkout')}</dt>
              <dd>{hotel.checkOut}</dd>
            </div>
            <div class="flex justify-between gap-4">
              <dt class="text-ink-3">{lang === 'es' ? 'Camas' : 'Beds'}</dt>
              <dd class="text-right">{hab.camas[lang]}</dd>
            </div>
          </dl>
        </div>
      </aside>
    </div>

    <section class="bg-base-2 py-24 lg:py-32">
      <div class="contenedor">
        <h2 class="revelar font-display text-seccion font-light">{t('hab.otras')}</h2>
        <div class="mt-12 grid gap-10 sm:grid-cols-2 lg:gap-8">
          {otras.map((h) => <CardHabitacion hab={h} lang={lang} />)}
        </div>
      </div>
    </section>
  </div>

  <CtaFinal lang={lang} />
  <Lightbox lang={lang} />
</Base>
