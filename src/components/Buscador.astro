---
import { Icon } from 'astro-icon/components';
import { useTranslations, ruta } from '../i18n/ui';
import { hotel, habitaciones } from '../data/hotel';
import { cop, dec } from '../lib/precios';
import type { Lang } from '../data/hotel';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);

const desde = Math.min(...habitaciones.map((h) => h.precios.baja));
---

<!--
  Barra de consulta de la portada: fechas, personas y botón en una sola
  píldora, con la marca del hotel (panel oscuro, botón oro). En móvil pasa a un
  bloque redondeado de 2x2. Envía a /reservar, que con las dos fechas salta
  directo a elegir habitación.
-->
<form id="buscador" action={ruta(lang, '/reservar')} method="get" class="mt-10">
  <div
    class="grid grid-cols-2 gap-1 rounded-[1.75rem] border border-line-2 bg-panel p-1.5 sm:grid-cols-[1fr_1fr_0.85fr_auto] sm:rounded-full"
  >
    <label for="b-entrada" class="celda">
      <span class="block text-[0.6875rem] text-ink-3">{t('buscador.entrada')}</span>
      <input
        id="b-entrada"
        name="entrada"
        type="date"
        required
        class="mt-0.5 w-full bg-transparent text-[0.9375rem] tabular-nums text-ink focus-visible:outline-none"
      />
    </label>

    <label for="b-salida" class="celda">
      <span class="block text-[0.6875rem] text-ink-3">{t('buscador.salida')}</span>
      <input
        id="b-salida"
        name="salida"
        type="date"
        required
        class="mt-0.5 w-full bg-transparent text-[0.9375rem] tabular-nums text-ink focus-visible:outline-none"
      />
    </label>

    <label for="b-huespedes" class="celda">
      <span class="block text-[0.6875rem] text-ink-3">{t('buscador.huespedes')}</span>
      <select
        id="b-huespedes"
        name="huespedes"
        class="mt-0.5 w-full appearance-none bg-transparent pr-6 text-[0.9375rem] text-ink focus-visible:outline-none"
      >
        {
          [1, 2, 3, 4, 5, 6, 7].map((n) => (
            <option value={n} selected={n === 2} class="bg-panel">
              {n} {n === 1 ? t('hab.persona') : t('hab.personas')}
            </option>
          ))
        }
      </select>
      <Icon
        name="ph:caret-down"
        class="pointer-events-none absolute bottom-[0.95rem] right-5 h-3.5 w-3.5 text-ink-3"
      />
    </label>

    <button type="submit" class="btn btn-oro h-full min-h-[3.25rem] w-full sm:px-8">
      {t('buscador.consultar')}
    </button>
  </div>

  <p class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-1.5 text-[0.8125rem] text-ink-2" data-cifras>
    <span class="inline-flex items-center gap-1.5">
      <Icon name="ph:star-fill" class="h-3.5 w-3.5 text-oro" />
      <strong class="font-semibold text-ink">{dec(hotel.rating, lang)}</strong>
      · {hotel.totalResenas} {t('buscador.resenas')}
    </span>
    <span class="h-3 w-px bg-line-2" aria-hidden="true"></span>
    <span>
      {t('hab.desde')} <strong class="font-semibold text-ink">{cop(desde, lang)}</strong>
      {t('hab.noche')}
    </span>
    <span class="h-3 w-px bg-line-2" aria-hidden="true"></span>
    <span>{t('res.pagoHotel')}</span>
  </p>
</form>

<style>
  /* Cada campo es una celda entera clicable. El foco se marca en la celda, no
     en el control: un contorno alrededor de un input sin borde queda torcido. */
  .celda {
    position: relative;
    display: block;
    min-width: 0;
    padding: 0.6rem 1.25rem 0.7rem;
    border-radius: 1.25rem;
    background: color-mix(in srgb, var(--color-panel-2) 55%, transparent);
    cursor: pointer;
    transition: background-color 0.2s var(--ease-suave);
  }
  .celda:hover {
    background: var(--color-panel-2);
  }
  .celda:focus-within {
    background: var(--color-panel-2);
    outline: 2px solid var(--color-oro-2);
    outline-offset: -2px;
  }

  /* En una fila: celdas transparentes en píldora, separadas por una línea fina
     que desaparece junto a la celda activa. */
  @media (min-width: 640px) {
    .celda {
      border-radius: var(--radius-pill);
      background: transparent;
    }
    .celda:not(:nth-child(3))::after {
      content: '';
      position: absolute;
      right: 0;
      top: 28%;
      height: 44%;
      width: 1px;
      background: var(--color-line-2);
      transition: opacity 0.2s var(--ease-suave);
    }
    .celda:hover::after,
    .celda:focus-within::after,
    .celda:has(+ .celda:hover)::after,
    .celda:has(+ .celda:focus-within)::after {
      opacity: 0;
    }
  }
</style>

<script>
  import { hoyISO } from '../lib/precios';

  const entrada = document.getElementById('b-entrada') as HTMLInputElement | null;
  const salida = document.getElementById('b-salida') as HTMLInputElement | null;

  if (entrada && salida) {
    entrada.min = hoyISO();
    salida.min = hoyISO(1);
    entrada.value = hoyISO(14);
    salida.value = hoyISO(16);

    entrada.addEventListener('change', () => {
      const siguiente = new Date(entrada.value + 'T12:00:00');
      siguiente.setDate(siguiente.getDate() + 1);
      const minSalida = siguiente.toISOString().slice(0, 10);
      salida.min = minSalida;
      if (salida.value <= entrada.value) salida.value = minSalida;
    });
  }
</script>
