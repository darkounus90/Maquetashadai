---
import Foto from './Foto.astro';

interface Props {
  titulo: string;
  bajada?: string;
  foto: string;
  alt: string;
}
const { titulo, bajada, foto, alt } = Astro.props;
---

<section class="relative isolate overflow-hidden bg-deep pb-14 pt-32 lg:pb-20 lg:pt-44">
  <div class="absolute inset-0 -z-10">
    <Foto id={foto} alt={alt} prioridad class="opacity-35" />
  </div>
  <div class="absolute inset-0 -z-10 bg-gradient-to-t from-deep via-deep/80 to-deep/50" aria-hidden="true"></div>

  <div class="contenedor grid gap-6 lg:grid-cols-12 lg:items-end lg:gap-12">
    <h1
      class="max-w-[16ch] font-display text-titulo font-extrabold text-white lg:col-span-7"
      style="font-variation-settings:'opsz' 84,'wdth' 90"
    >
      {titulo}
    </h1>
    {
      bajada && (
        <p class="max-w-lg text-[0.9375rem] leading-relaxed text-white/75 lg:col-span-5 lg:pb-2">{bajada}</p>
      )
    }
  </div>
</section>
