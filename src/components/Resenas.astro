---
import { Icon } from 'astro-icon/components';
import { useTranslations } from '../i18n/ui';
import { hotel, resenas, puntajes } from '../data/hotel';
import type { Lang } from '../data/hotel';
import Titulo from './Titulo.astro';
import { dec } from '../lib/precios';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="bg-fondo-2 py-24 lg:py-32">
  <div class="contenedor">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <Titulo
          titulo={t('prueba.titulo')}
        />

        <div class="revelar mt-10 flex items-center gap-5">
          <span
            class="grid h-16 w-16 place-items-center bg-panel font-display text-2xl text-ink"
          >
            {dec(hotel.rating, lang)}
          </span>
          <span class="leading-tight">
            <span class="block font-display text-xl">{t('prueba.excepcional')}</span>
            <span class="block text-sm text-ink-3">
              {hotel.totalResenas} {t('prueba.resenas')}
            </span>
          </span>
        </div>

        <dl class="revelar mt-10 grid max-w-md grid-cols-2 gap-x-8 gap-y-4">
          {
            puntajes.map((p) => (
              <div>
                <div class="flex items-baseline justify-between gap-3">
                  <dt class="text-sm text-ink-2">{p.cat[lang]}</dt>
                  <dd class="font-display text-sm">{dec(p.n, lang)}</dd>
                </div>
                <div class="mt-1.5 h-[3px] w-full overflow-hidden bg-line">
                  <div class="h-full bg-oro" style={`width:${p.n * 10}%`} />
                </div>
              </div>
            ))
          }
        </dl>
      </div>

      <div class="lg:col-span-7">
        <ul class="grid gap-5 sm:grid-cols-2">
          {
            resenas.map((r, i) => (
              <li
                class="revelar flex flex-col border border-line bg-panel p-6"
                style={`transition-delay:${i * 60}ms`}
              >
                <Icon name="ph:quotes-fill" class="h-5 w-5" />
                <p class="mt-4 flex-1 text-sm leading-relaxed text-ink-2">
                  {r.texto[lang]}
                </p>
                <p class="mt-5 text-xs uppercase tracking-widest text-ink-3">
                  {r.nombre}, {r.pais[lang]}
                </p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
