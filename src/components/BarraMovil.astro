---
import { Icon } from 'astro-icon/components';
import { ruta } from '../i18n/ui';
import { hotel } from '../data/hotel';
import type { Lang } from '../data/hotel';

interface Props { lang: Lang }
const { lang } = Astro.props;

// Este hotel cierra reservas por WhatsApp. En móvil eso no puede estar a tres
// scrolls de distancia: va fijo abajo, junto al motor de reservas.
const waMsg = encodeURIComponent(
  lang === 'es'
    ? 'Hola, vengo de la página web y quiero información sobre una reserva.'
    : 'Hello, I found you on your website and would like information about a booking.'
);

const etiquetas = {
  es: { wa: 'WhatsApp', reservar: 'Reservar', compartir: 'Compartir', copiado: 'Enlace copiado' },
  en: { wa: 'WhatsApp', reservar: 'Book', compartir: 'Share', copiado: 'Link copied' },
}[lang];
---

<!-- Tres píldoras, como el resto de los botones del sitio. El relleno inferior
     respeta la zona segura del iPhone. -->
<div
  class="flex items-center gap-2 border-t border-line-2 bg-deep/95 px-3 pt-2.5 backdrop-blur lg:hidden"
  style="padding-bottom:max(0.625rem, env(safe-area-inset-bottom))"
>
  <button
    type="button"
    data-compartir
    data-copiado={etiquetas.copiado}
    class="grid h-11 w-11 shrink-0 place-items-center rounded-full border border-line-2 text-ink transition-colors hover:border-oro hover:text-oro-luz"
    aria-label={etiquetas.compartir}
  >
    <Icon name="ph:share-network" class="h-5 w-5" />
  </button>

  <a
    href={`https://wa.me/${hotel.whatsapp}?text=${waMsg}`}
    target="_blank"
    rel="noopener"
    class="flex h-11 flex-1 items-center justify-center gap-2 rounded-full border border-oro/65 text-[0.8125rem] font-semibold text-ink transition-colors hover:border-oro hover:text-oro-luz"
  >
    <Icon name="ph:whatsapp-logo" class="h-[1.125rem] w-[1.125rem]" />
    {etiquetas.wa}
  </a>

  <a
    href={ruta(lang, '/reservar')}
    class="flex h-11 flex-1 items-center justify-center gap-2 rounded-full bg-oro text-[0.8125rem] font-semibold text-granate shadow-[inset_0_1px_0_rgb(255_255_255/0.28)] transition-colors hover:bg-oro-2"
  >
    <Icon name="ph:calendar-check" class="h-[1.125rem] w-[1.125rem]" />
    {etiquetas.reservar}
  </a>
</div>
