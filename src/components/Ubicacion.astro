---
import { Icon } from 'astro-icon/components';
import { useTranslations } from '../i18n/ui';
import { hotel } from '../data/hotel';
import type { Lang } from '../data/hotel';
import Titulo from './Titulo.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);

const { lat, lng } = hotel.coords;

// El recuadro se centra exactamente en el hotel: así el marcador propio que va
// superpuesto cae en el centro geométrico de la placa y no hace falta el
// marcador verde de OpenStreetMap, que no pega con la paleta.
const bbox = `${lng - 0.02}%2C${lat - 0.014}%2C${lng + 0.02}%2C${lat + 0.014}`;
const mapa = `https://www.openstreetmap.org/export/embed.html?bbox=${bbox}&layer=mapnik`;
const maps = `https://www.google.com/maps/search/?api=1&query=${lat}%2C${lng}`;

// Coordenadas en el formato de un plano, no en decimal crudo.
const coordenadas =
  `${Math.abs(lat).toFixed(4)}° ${lat >= 0 ? 'N' : 'S'}  ` +
  `${Math.abs(lng).toFixed(4)}° ${lng >= 0 ? 'E' : lang === 'es' ? 'O' : 'W'}`;

const esquinas = [
  'left-3 top-3 border-l border-t',
  'right-3 top-3 border-r border-t',
  'left-3 bottom-3 border-b border-l',
  'right-3 bottom-3 border-b border-r',
];
---

<section class="bg-base py-24 lg:py-32">
  <div class="contenedor grid gap-12 lg:grid-cols-12 lg:items-center lg:gap-16">
    <div class="lg:col-span-5">
      <Titulo
        titulo={t('ubi.titulo')}
        bajada={t('ubi.bajada')}
      />

      <address class="revelar mt-8 flex items-start gap-3 text-sm not-italic leading-relaxed text-ink-2">
        <Icon name="ph:map-pin" class="mt-0.5 h-4 w-4 shrink-0 text-brasa-luz" />
        {hotel.direccion}
      </address>

      <dl class="revelar mt-8 divide-y divide-line border-y border-line">
        {
          hotel.distancias[lang].map(([lugar, dist]) => (
            <div class="flex items-baseline justify-between gap-6 py-3.5">
              <dt class="text-sm text-ink-2">{lugar}</dt>
              <dd class="shrink-0 font-display text-sm text-brasa-luz">{dist}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <!-- Placa cartográfica: cabecera con coordenadas, mapa oscurecido con
         marcador propio, y pie con la atribución y la acción. -->
    <figure class="revelar border border-line-2 bg-panel lg:col-span-7">
      <figcaption
        class="flex items-center justify-between gap-4 border-b border-line-2 px-4 py-3"
      >
        <span class="rotulo flex items-center gap-2 text-ink-2">
          <Icon name="ph:crosshair" class="h-3.5 w-3.5 shrink-0 text-brasa-luz" />
          <span class="tabular-nums">{coordenadas}</span>
        </span>
        <span class="rotulo hidden text-ink-3 sm:block">Villavieja · Huila</span>
      </figcaption>

      <div class="relative aspect-[4/3] overflow-hidden bg-base-2 lg:aspect-[16/10]">
        <!-- El iframe se desborda 3rem por lado: recorta los controles de zoom
             y la barra de atribución de OSM (que se repone abajo) sin mover el
             centro, que es lo que mantiene el marcador alineado.
             Sin interacción: en móvil un mapa embebido secuestra el scroll. -->
        <iframe
          src={mapa}
          title={lang === 'es'
            ? 'Mapa de la ubicación del hotel en Villavieja'
            : 'Map showing the hotel location in Villavieja'}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          class="mapa-placa pointer-events-none absolute -inset-12 h-[calc(100%+6rem)] w-[calc(100%+6rem)]"
        ></iframe>

        <!-- Vela el mapa hacia la paleta de la página. -->
        <div class="pointer-events-none absolute inset-0 bg-brasa/[0.06]" aria-hidden="true"></div>

        <!-- Marcas de registro, como un plano. -->
        {
          esquinas.map((pos) => (
            <span
              class={`pointer-events-none absolute h-4 w-4 border-ink/25 ${pos}`}
              aria-hidden="true"
            />
          ))
        }

        <!-- Marcador propio, en el centro exacto del recuadro. -->
        <div
          class="pointer-events-none absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2"
          aria-hidden="true"
        >
          <span
            class="absolute left-1/2 top-1/2 h-14 w-14 -translate-x-1/2 -translate-y-1/2 animate-ping border border-brasa-2/50 motion-reduce:animate-none"
          ></span>
          <span
            class="absolute left-1/2 top-1/2 h-7 w-7 -translate-x-1/2 -translate-y-1/2 border border-brasa-2/60 bg-brasa/15"
          ></span>
          <span
            class="absolute left-1/2 top-1/2 h-2.5 w-2.5 -translate-x-1/2 -translate-y-1/2 bg-brasa ring-2 ring-ink"
          ></span>
        </div>
      </div>

      <div
        class="flex items-center justify-between gap-4 border-t border-line-2 px-4 py-3"
      >
        <span class="text-[0.6875rem] leading-tight text-ink-3">
          © <a
            href="https://www.openstreetmap.org/copyright"
            target="_blank"
            rel="noopener"
            class="underline decoration-line-2 underline-offset-2 transition-colors hover:text-ink-2">OpenStreetMap</a
          >
        </span>
        <a
          href={maps}
          target="_blank"
          rel="noopener"
          class="rotulo group flex shrink-0 items-center gap-2 text-ink transition-colors hover:text-brasa-luz"
        >
          {t('ubi.mapa')}
          <Icon
            name="ph:arrow-up-right"
            class="h-3.5 w-3.5 transition-transform group-hover:-translate-y-px group-hover:translate-x-px"
          />
        </a>
      </div>
    </figure>
  </div>
</section>

<style>
  /* OpenStreetMap solo sirve teselas claras. Se invierten y se giran 180° en
     el matiz para que el agua siga siendo azul y el verde siga siendo verde,
     y se baja la saturación para que el mapa no compita con el acento. */
  .mapa-placa {
    filter: invert(1) hue-rotate(180deg) brightness(0.92) contrast(0.92) saturate(0.5);
  }
</style>
